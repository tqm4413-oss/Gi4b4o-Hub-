--- Main Functions ---

MainTab:CreateToggle({
   Name = "Đánh quái từ xa (Killaura)",
   CurrentValue = false,
   Callback = function(Value)
      _G.Killaura = Value
      while _G.Killaura do
         task.wait(0.1)
         pcall(function()
            for _, monster in pairs(workspace.Monsters:GetChildren()) do
                local distance = (Character.HumanoidRootPart.Position - monster.HumanoidRootPart.Position).Magnitude
                if distance < 20 then
                    -- Thay đổi 'Attack' bằng Remote tương ứng của game
                    game:GetService("ReplicatedStorage").Remotes.Attack:FireServer(monster)
                end
            end
         end)
      end
   end,
})

MainTab:CreateToggle({
   Name = "Bất tử (God Mode)",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
          Character.Humanoid.MaxHealth = math.huge
          Character.Humanoid.Health = math.huge
      else
          Character.Humanoid.MaxHealth = 100
      end
   end,
})

MainTab:CreateSlider({
   Name = "Tốc độ chạy (Walkspeed)",
   Range = {16, 300},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(Value)
      Humanoid.WalkSpeed = Value
   end,
})

MainTab:CreateSlider({
   Name = "Độ cao bay (Fly)",
   Range = {0, 500},
   Increment = 5,
   CurrentValue = 0,
   Callback = function(Value)
      local bv = Character.HumanoidRootPart:FindFirstChild("TabFly") or Instance.new("BodyVelocity", Character.HumanoidRootPart)
      bv.Name = "TabFly"
      if Value > 0 then
          bv.Velocity = Vector3.new(0, Value, 0)
          bv.MaxForce = Vector3.new(0, math.huge, 0)
      else
          bv:Destroy()
      end
   end,
})

