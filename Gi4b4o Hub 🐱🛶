-- TAB CHÍNH: SURVIVAL
local MainTab = Window:CreateTab("🌊 Survival", 4483362458)

MainTab:CreateSection("Auto Features")

MainTab:CreateToggle({
   Name = "Auto Collect Items (Tự hút đồ)",
   CurrentValue = false,
   Flag = "AutoCollect",
   Callback = function(Value)
      _G.AutoCollect = Value
      spawn(function()
          while _G.AutoCollect do
              pcall(function()
                  for _, v in pairs(game.Workspace:GetChildren()) do
                      if v:IsA("Part") and (v.Name == "Plank" or v.Name == "Plastic" or v.Name == "Leaf") then
                          v.CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
                      end
                  end
              end)
              task.wait(0.5)
          end
      end)
   end,
})

MainTab:CreateToggle({
   Name = "Infinite Oxygen & Hunger",
   CurrentValue = false,
   Flag = "InfStats",
   Callback = function(Value)
      _G.God = Value
      spawn(function()
          while _G.God do
              pcall(function()
                  game.Players.LocalPlayer.Character.Values.Oxygen.Value = 100
                  game.Players.LocalPlayer.Character.Values.Hunger.Value = 100
              end)
              task.wait(1)
          end
      end)
   end,
})

