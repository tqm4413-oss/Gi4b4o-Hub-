-- TAB CHÍNH: HIKING
local MainTab = Window:CreateTab("🏔️ Leo Núi", 4483362458)

MainTab:CreateSection("Tính Năng Hỗ Trợ")

MainTab:CreateToggle({
   Name = "Infinite Stamina (Vô hạn thể lực)",
   CurrentValue = false,
   Flag = "InfStamina",
   Callback = function(Value)
      _G.InfStamina = Value
      spawn(function()
          while _G.InfStamina do
              pcall(function()
                  -- Logic stamina tùy thuộc vào cấu trúc game
                  local char = game.Players.LocalPlayer.Character
                  if char:FindFirstChild("Stamina") then
                      char.Stamina.Value = 100
                  end
              end)
              task.wait(0.5)
          end
      end)
   end,
})

